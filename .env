# 程序相关配置
APP_NAME=ai_agent
APP_VERSION=1.0.0
APP_LOG_DEBUG=debug
APP_HOST=0.0.0.0
APP_PORT=1000
APP_RELOAD=TRUE

# 日志配置
LOG_LEVEL=INFO
LOG_FILE_PATH=log/ai_agent.log

# 模型配置
MODELS='{
  "qwen": {
    "model_name": "qwen3.5:9b",
    "model_provider": "openai",
    "api_key": "ollama",
    "base_url": "http://localhost:11434/v1",
    "temperature": 0,
    "timeout": 30,
    "max_retries": 2,
    "context_window": 64000,
    "max_output_tokens": 8192
  },
  "openbmb": {
    "model_name": "openbmb/minicpm5:latest",
    "model_provider": "openai",
    "api_key": "ollama",
    "base_url": "http://localhost:11434/v1",
    "temperature": 0,
    "timeout": 30,
    "max_retries": 2,
    "context_window": 32000,
    "max_output_tokens": 8192
  },
  "classifier": {
    "model_name": "openbmb/minicpm5:latest",
    "model_provider": "openai",
    "api_key": "ollama",
    "base_url": "http://localhost:11434/v1",
    "temperature": 0,
    "timeout": 30,
    "max_retries": 2,
    "context_window": 32000,
    "max_output_tokens": 8192
  }
}'

AGENT_PROFILES='{
    "assistant":{
        "description":"通用智能助手",
        "system_prompt":"你是一个通用智能助手，负责理解用户需求并提供准确、有帮助的回答。",
        "tools":["weather_tool","calculate_tool","current_time_tool","fetch_webpage_tool","read_file_tool","write_file_tool","list_directory_tool","read_file_metadata_tool","system_info_tool","system_resource_tool","search_web_tool"]
    },
    "coder":{
        "description":"编程开发助手",
        "system_prompt":"你是一个专业的编程助手，擅长代码分析、编写、修改和调试。",
        "tools":["calculate_tool","read_file_tool","write_file_tool","list_directory_tool","read_file_metadata_tool","search_web_tool","fetch_webpage_tool","current_time_tool"]
    }
}'

AGENT_MODEL_MAP='{
  "assistant": "qwen",
  "coder": "openbmb"
}'

CLASSIFIER_MODEL="classifier"
CLASSIFIER_SYSTEM_PROMPT='"""你是一个任务分类器，负责识别用户当前输入的任务类型。
            可选任务类型：
            - general：普通交流、闲聊或无法归入其他类别的任务
            - coding：编程、代码分析、调试、算法和技术实现
            - research：资料研究、信息调查、分析和比较
            - writing：写作、润色、改写、翻译和内容创作
            - question_answering：知识问答、概念解释和事实性问题
            分类要求：
            1. 根据用户输入的实际意图进行语义分类，不要只匹配关键词。
            2. 支持多标签分类，一个输入可以属于多个任务类型。
            3. 只返回符合任务类型定义的结果。
            4. 如果没有明确的专项任务，返回 general。
            5. general 不能与其他类型同时出现。
            输出要求：
            1. 必须返回合法的 JSON 对象。
            2. JSON 必须包含 task_types 字段，值为字符串数组。
            3. task_types 中的值必须使用上述任务类型的小写标识。
            4. 不允许输出 Markdown、解释文字或其他无关内容。

            输出格式：
            {
                "task_types": ["general"]
            }
            """'