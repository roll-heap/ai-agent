# 程序相关配置
APP_NAME=ai_agent
APP_VERSION=1.0.0
APP_LOG_DEBUG=debug
APP_HOST=0.0.0.0
APP_PORT=1000
APP_RELOAD=TRUE

# 日志配置
LOG_LEVEL=INFO
LOG_FILE_PATH=log/ai_agent.log

# 模型配置，classifier是通过ollama创建的llm
MODELS='{
  "qwen": {
    "model_name": "qwen3.5:9b",
    "model_provider": "openai",
    "api_key": "ollama",
    "base_url": "http://localhost:11434/v1",
    "temperature": 0,
    "timeout": 30,
    "max_retries": 2,
    "context_window": 64000,
    "max_output_tokens": 8192
  },
  "deepseek": {
    "model_name": "w2n/deepseek-v4-flash",
    "model_provider": "openai",
    "api_key": "ollama",
    "base_url": "http://localhost:11434/v1",
    "temperature": 0,
    "timeout": 30,
    "max_retries": 2,
    "context_window": 32000,
    "max_output_tokens": 8192
  },
  "minicpm5": {
    "model_name": "openbmb/minicpm5:latest",
    "model_provider": "openai",
    "api_key": "ollama",
    "base_url": "http://localhost:11434/v1",
    "temperature": 0,
    "timeout": 30,
    "max_retries": 2,
    "context_window": 32000,
    "max_output_tokens": 8192
  }
}'

AGENT_PROFILES='{
    "assistant":{
        "description":"通用智能助手",
        "system_prompt":"你是一个通用智能助手，负责理解用户需求并提供准确、有帮助的回答。",
        "tools":["weather_tool","calculate_tool","current_time_tool","fetch_webpage_tool","read_file_tool","write_file_tool","list_directory_tool","read_file_metadata_tool","system_info_tool","system_resource_tool","search_web_tool"]
    },
    "coder":{
        "description":"编程开发助手",
        "system_prompt":"你是一个专业的编程助手，擅长代码分析、编写、修改和调试。",
        "tools":["calculate_tool","read_file_tool","write_file_tool","list_directory_tool","read_file_metadata_tool"]
    },
    "researcher":{
        "description":"资料研究助手",
        "system_prompt":"你是一个研究助手，擅长搜索资料、阅读网页和整理信息。",
        "tools":["search_web_tool","fetch_webpage_tool","current_time_tool"]
    }
}'

AGENT_MODEL_MAP='{
  "assistant": "qwen",
  "coder": "deepseek",
  "researcher":"minicpm5"
}'