# 程序相关配置
APP_NAME=ai_agent
APP_VERSION=1.0.0
APP_LOG_DEBUG=debug
APP_HOST=0.0.0.0
APP_PORT=1000
APP_RELOAD=TRUE

# 日志配置
LOG_LEVEL=INFO
LOG_FILE_PATH=log/ai_agent.log

# 模型配置，classifier是通过ollama创建的llm
MODELS='{
  "qwen3.5:9b": {
    "model_name": "qwen3.5:9b",
    "model_provider": "openai",
    "api_key": "ollama",
    "base_url": "http://localhost:11434/v1",
    "temperature": 0,
    "timeout": 30,
    "max_retries": 2,
    "context_window": 64000,
    "max_output_tokens": 8192,
    "hugging_face_config": {
      "name_or_path": "Qwen/Qwen3.5-9B",
      "revision": "main",
      "chat_template": null,
      "runtime_compatible": false
    }
  },
  "qwen3.5:4b": {
    "model_name": "qwen3.5:4b",
    "model_provider": "openai",
    "api_key": "ollama",
    "base_url": "http://localhost:11434/v1",
    "temperature": 0,
    "timeout": 30,
    "max_retries": 2,
    "context_window": 64000,
    "max_output_tokens": 8192,
    "hugging_face_config": {
      "name_or_path": "Qwen/Qwen3.5-9B",
      "revision": "main",
      "chat_template": null,
      "runtime_compatible": false
    }
  },
  "minicpm5": {
    "model_name": "openbmb/minicpm5:latest",
    "model_provider": "openai",
    "api_key": "ollama",
    "base_url": "http://localhost:11434/v1",
    "temperature": 0,
    "timeout": 30,
    "max_retries": 2,
    "context_window": 32000,
    "max_output_tokens": 8192,
    "hugging_face_config": {
      "name_or_path": "openbmb/minicpm5-2b",
      "revision": "main",
      "chat_template": null,
      "runtime_compatible": false
    }
  }
}'

AGENT_PROFILES='{
    "assistant":{
        "description":"通用智能助手",
        "system_prompt":"你是一个智能助手。请根据用户的问题判断是否需要调用工具。如果需要工具：1. 选择最合适的工具。2. 正确填写工具参数。3. 根据工具返回结果回答用户。4. 不要编造工具没有返回的数据。5. 如果工具执行失败，应根据工具返回的错误信息进行回答。6. 如果不需要工具，可以直接回答用户。工具调用由系统负责执行。",
        "tools":["weather_tool","calculate_tool","current_time_tool","fetch_webpage_tool","read_file_tool","write_file_tool","list_directory_tool","read_file_metadata_tool","system_info_tool","system_resource_tool","search_web_tool"]
    },
    "coder":{
        "description":"编程开发助手",
        "system_prompt":"你是一个专业的编程助手，擅长代码分析、编写、修改和调试。",
        "tools":["calculate_tool","read_file_tool","write_file_tool","list_directory_tool","read_file_metadata_tool"]
    },
    "researcher":{
        "description":"资料研究助手",
        "system_prompt":"你是一个研究助手，擅长搜索资料、阅读网页和整理信息。",
        "tools":["search_web_tool","fetch_webpage_tool","current_time_tool"]
    }
}'

AGENT_MODEL_MAP='{
  "assistant": "qwen3.5:9b",
  "coder": "qwen3.5:4b",
  "researcher":"minicpm5"
}'